# ==============================================================================
# FLOWZA BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Environment mode: 'development', 'staging', or 'production'
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# DATABASE CONNECTION
# ------------------------------------------------------------------------------
# 1. Local Development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./flowza.db

# 2. Production (Supabase PostgreSQL):
# Format A - Direct Connection (port 5432):
# DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Format B - Connection Pooler / PgBouncer (port 6543) [Recommended for Serverless/Render]:
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# FRONTEND & CORS ORIGINS
# ------------------------------------------------------------------------------
# Local development default:
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# GOOGLE GEMINI MULTI-MODEL AGENTIC AI
# ------------------------------------------------------------------------------
# Get your free API key at https://aistudio.google.com/app/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.7-flash
AI_TIMEOUT=25
AI_MAX_TOOL_CALLS=5
